  "transaction": {
    "obj_name": "fam_asset_installation",
    "sql_models": [
      {
        "sql_model": {
          "form_title": "Asset Installation",
          "form_descr": "Record and confirm the date and details of physical installation/commissioning of a capitalized asset at its assigned location, marking the point from which the asset is put to use",
          "form_no": "1",
          "main_table": "FAM_ASSET_INSTALLATION",
          "columns": [
            {
              "column": {
                "name": "asset_code",
                "db_name": "ASSET_CODE",
                "table_name": "FAM_ASSET_INSTALLATION",
                "group_name": "Basic",
                "col_type": "VARCHAR",
                "heading": "Asset Code",
                "descr": "Capitalized asset being installed/commissioned",
                "mandatory": true,
                "lookup": "FAM_ASSET_REGISTER(ASSET_NAME, ASSET_CODE)",
                "validations": [
                  {
                    "type": "builtin",
                    "name": "Asset must be Capitalized",
                    "error_code": "ASSET_MUST_BE_CAPITALIZED",
                    "message": "Asset {form.asset_code} does not exist or is not in Capitalized status.",
                    "builtin": {
                      "kind": "must_exist_in_master",
                      "table": "FAM_ASSET_REGISTER",
                      "match_column": "ASSET_CODE",
                      "conditions": [
                        {
                          "column": "STATUS",
                          "op": "=",
                          "source": "const",
                          "value": "CAPITALIZED"
                        }
                      ]
                    }
                  },
                  {
                    "type": "builtin",
                    "name": "One active installation per asset",
                    "error_code": "ASSET_INSTALL_UNIQUE_ACTIVE",
                    "message": "An active installation record already exists for asset {form.asset_code}.",
                    "builtin": {
                      "kind": "must_be_unique",
                      "match_column": "ASSET_CODE",
                      "conditions": [
                        {
                          "column": "STATUS",
                          "op": "!=",
                          "source": "const",
                          "value": "CANCELLED"
                        }
                      ]
                    }
                  }
                ],
                "x": "10",
                "y": "10",
                "col_id": "1",
                "table_display_name": "Asset installation record (main table)",
                "db_size": "20",
