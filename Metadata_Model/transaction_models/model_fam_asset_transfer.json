            }
          },
          "validations": [
            {
              "type": "expression",
              "name": "TO must differ from FROM",
              "error_code": "TRANSFER_NO_CHANGE",
              "message": "The To branch/location/department/employee combination must differ from the From combination.",
              "expression": "not ({form.to_branch_code} == {form.from_branch_code} and {form.to_location_code} == {form.from_location_code} and {form.to_department_code} == {form.from_department_code} and {form.to_employee_code} == {form.from_employee_code})"
            },
            {
              "type": "business_logic",
              "name": "From location matches asset's current location",
              "message": "The From branch/location/department/employee must match the asset's current recorded location.",
              "business_logic": {
                "method": "verify_from_matches_current_location",
                "description": "Ensure from_* values still match the asset's current location before save",
                "spec": "On add (and on edit while status is still DRAFT), re-fetch the asset's current BRANCH_CODE, LOCATION_CODE, DEPARTMENT_CODE and ASSIGNED_EMPLOYEE_CODE from the Asset Register for ASSET_CODE and compare them to from_branch_code/from_location_code/from_department_code/from_employee_code on this record; return an error ({\"error\":\"...\"}) if any differ. Skip the check when _action = 'edit' and the stored status is no longer DRAFT (already-submitted/approved records are immutable history). Depends on FAM_ASSET_REGISTER carrying BRANCH_CODE/LOCATION_CODE/DEPARTMENT_CODE/ASSIGNED_EMPLOYEE_CODE columns (see the fill_asset_current_location item_change function).",
                "language": "plpgsql"
              }
            }
          ]
        }
      }
    ],
    "actions": [
      {
        "name": "edit",
        "handler": "system",
        "system_op": "edit",
        "scope": "row",
        "validations": [
          {
            "type": "expression",
            "name": "Draft only",
            "message": "Only DRAFT transfers can be edited (current status {form.status}).",
            "expression": "{form.status} == \"DRAFT\""
          }
        ]
      },
      {
        "name": "Submit for Approval",
        "handler": "message",
        "scope": "row",
        "business_logic": {
          "method": "submit_asset_transfer_for_approval",
          "description": "Move a Draft transfer to Pending Approval",
          "spec": "Set STATUS to PENDING_APPROVAL on this transfer record and return a confirmation message.",
          "language": "plpgsql"
        },
        "validations": [
          {
            "type": "expression",
            "name": "Must be Draft",
            "message": "Only DRAFT transfers can be submitted for approval (current status {form.status}).",
            "expression": "{form.status} == \"DRAFT\""
          }
        ]
      },
      {
        "name": "Approve",
        "handler": "message",
        "scope": "row",
        "business_logic": {
          "method": "approve_asset_transfer",
          "description": "Approve the transfer and update the Asset Register's current location/custody",
          "spec": "Set STATUS to APPROVED on this transfer record. Then UPDATE the Asset Register row for ASSET_CODE, setting its current BRANCH_CODE/LOCATION_CODE/DEPARTMENT_CODE/ASSIGNED_EMPLOYEE_CODE to this record's to_branch_code/to_location_code/to_department_code/to_employee_code. This FAM_ASSET_TRANSFER row itself remains as the permanent audit trail of the movement (no separate history table needed). Return a confirmation message. Depends on FAM_ASSET_REGISTER carrying BRANCH_CODE/LOCATION_CODE/DEPARTMENT_CODE/ASSIGNED_EMPLOYEE_CODE columns.",
          "language": "plpgsql"
        },
        "validations": [
          {
            "type": "expression",
            "name": "Must be Pending Approval",
            "message": "Only PENDING APPROVAL transfers can be approved (current status {form.status}).",
            "expression": "{form.status} == \"PENDING_APPROVAL\""
          }
        ],
        "confirmation": {
          "mode": "reconfirm",
          "message": "Approve transfer {form.transfer_no} for asset {form.asset_code}? This will update the Asset Register's current location."
        }
      },
      {
        "name": "Cancel",
        "handler": "message",
        "scope": "row",
        "business_logic": {
          "method": "cancel_asset_transfer",
          "description": "Cancel a Draft or Pending Approval transfer",
          "spec": "Set STATUS to CANCELLED on this transfer record and return a confirmation message. Approved transfers cannot be cancelled since the Asset Register has already been updated by the approval.",
          "language": "plpgsql"
        },
        "validations": [
          {
            "type": "expression",
            "name": "Cannot cancel Approved/Cancelled",
            "message": "Only DRAFT or PENDING APPROVAL transfers can be cancelled (current status {form.status}).",
            "expression": "{form.status} == \"DRAFT\" or {form.status} == \"PENDING_APPROVAL\""
          }
        ],
        "confirmation": {
          "mode": "reconfirm",
          "message": "Cancel transfer {form.transfer_no}?"
        }
      }
    ],
