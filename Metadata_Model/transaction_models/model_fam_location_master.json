          },
          "actions": [
            {
              "name": "delete",
              "handler": "system",
              "system_op": "delete",
              "scope": "row",
              "validations": [
                {
                  "type": "business_logic",
                  "name": "Location unused check",
                  "message": "This location cannot be deleted because it is referenced by one or more assets in the Asset Register.",
                  "business_logic": {
                    "method": "check_location_unused",
                    "description": "Block delete when the location is referenced by any asset",
                    "spec": "Given the current row's BRANCH_CODE and LOCATION_CODE, check whether any row exists in the Asset Register (FAM_ASSET_REGISTER) with matching BRANCH_CODE and LOCATION_CODE. If at least one such asset exists, return an error so the delete is blocked; otherwise return NULL/no error to allow the delete to proceed.",
                    "language": "plpgsql"
                  }
                }
              ]
            },
            {
              "name": "Activate",
              "handler": "message",
              "scope": "row",
              "business_logic": {
                "method": "activate_location",
                "description": "Activate the location",
                "spec": "UPDATE FAM_LOCATION_MASTER SET STATUS = 'A', CHG_DATE = current timestamp, CHG_USER = current user, CHG_TERM = current terminal WHERE BRANCH_CODE = the payload's BRANCH_CODE and LOCATION_CODE = the payload's LOCATION_CODE. Return a confirmation message that the location was activated.",
                "language": "plpgsql"
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Must not already be active",
                  "message": "Location {form.location_code} is already Active.",
                  "expression": "{form.status} != \"A\""
                }
              ]
            },
            {
              "name": "Deactivate",
              "handler": "message",
              "scope": "row",
              "business_logic": {
                "method": "deactivate_location",
                "description": "Deactivate the location",
                "spec": "UPDATE FAM_LOCATION_MASTER SET STATUS = 'I', CHG_DATE = current timestamp, CHG_USER = current user, CHG_TERM = current terminal WHERE BRANCH_CODE = the payload's BRANCH_CODE and LOCATION_CODE = the payload's LOCATION_CODE. Return a confirmation message that the location was deactivated.",
                "language": "plpgsql"
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Must not already be inactive",
                  "message": "Location {form.location_code} is already Inactive.",
                  "expression": "{form.status} != \"I\""
                }
              ]
            }
          ],
