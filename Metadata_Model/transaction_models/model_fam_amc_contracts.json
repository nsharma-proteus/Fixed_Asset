                "name": "status",
                "db_name": "STATUS",
                "col_type": "VARCHAR",
                "group_name": "Basic",
                "heading": "Status",
                "descr": "Contract lifecycle status. Assumption: DRAFT and PENDING_APPROVAL were added ahead of Active, to support the FRS-required Submit-for-approval/Approve actions -- the FRS's own STATUS list (Active/Expired/Renewed/Cancelled) has no pre-approval state.",
                "default_value": "DRAFT",
                "protect": "1",
                "mandatory": true,
                "edit_mask": {
                  "mask": "ddlb",
                  "values": [
                    {
                      "data": "DRAFT",
                      "display": "Draft"
                    },
                    {
                      "data": "PENDING_APPROVAL",
                      "display": "Pending Approval"
                    },
                    {
                      "data": "ACTIVE",
                      "display": "Active"
                    },
                    {
                      "data": "EXPIRED",
                      "display": "Expired"
                    },
                    {
                      "data": "RENEWED",
                      "display": "Renewed"
                    },
                    {
                      "data": "CANCELLED",
                      "display": "Cancelled"
                    }
                  ]
                },
                "display": {
                  "type": "status_tag",
                  "map": [
                    {
                      "when": "DRAFT",
                      "color": "grey"
                    },
                    {
                      "when": "PENDING_APPROVAL",
                      "color": "amber"
                    },
                    {
                      "when": "ACTIVE",
                      "color": "green"
                    },
                    {
                      "when": "EXPIRED",
                      "color": "orange"
                    },
                    {
                      "when": "RENEWED",
                      "color": "blue"
                    },
                    {
                      "when": "CANCELLED",
                      "color": "red"
                    }
                  ],
                  "defaultColor": "grey"
                },
