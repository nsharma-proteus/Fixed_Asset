                "must_exist_in": "FAM_ASSET_REGISTER",
                "validations": [
                  {
                    "type": "business_logic",
                    "name": "Asset must be Capitalized",
                    "message": "Asset must exist and be in Capitalized status to be covered under an AMC contract",
                    "business_logic": {
                      "method": "validate_asset_capitalized_for_amc",
                      "description": "Ensure the asset is Capitalized before allowing it to be added to an AMC contract line",
                      "spec": "Verify ASSET_CODE exists in FAM_ASSET_REGISTER and is in Capitalized status, returning an error if not (dependency: FAM_ASSET_REGISTER currently only carries ASSET_CODE, ASSET_NAME, CAPITALIZATION_DATE -- it does not yet have a STATUS column, so until that column is added only existence can be checked here; revisit once STATUS exists).",
                      "language": "plpgsql"
                    }
                  },
                  {
                    "type": "builtin",
                    "name": "Asset unique within contract",
                    "message": "This asset is already covered under this AMC contract.",
                    "builtin": {
                      "kind": "must_be_unique",
                      "conditions": [
