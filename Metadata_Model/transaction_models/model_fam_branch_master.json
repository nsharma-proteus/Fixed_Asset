          "actions": [
            {
              "name": "Delete",
              "handler": "system",
              "system_op": "delete",
              "scope": "row",
              "validations": [
                {
                  "type": "business_logic",
                  "name": "Branch not in use",
                  "error_code": "BRANCH_IN_USE",
                  "message": "This branch cannot be deleted because it is referenced by locations, departments, employees or assets.",
                  "business_logic": {
                    "method": "check_branch_unused",
                    "description": "Block delete if the branch is referenced elsewhere",
                    "spec": "Given BRANCH_CODE in the payload, check whether it is referenced in FAM_LOCATION_MASTER.BRANCH_CODE, FAM_DEPARTMENT_MASTER.BRANCH_CODE, FAM_EMPLOYEE_MASTER.BRANCH_CODE, or FAM_ASSET_REGISTER.BRANCH_CODE (only tables that exist in the project at deploy time need to be checked). If any matching row exists in any of these tables, return an error indicating the branch is in use and cannot be deleted. Otherwise return no error so the delete proceeds.",
                    "language": "plpgsql"
                  }
                }
              ]
            },
            {
              "name": "Activate",
              "handler": "item_change",
              "scope": "row",
              "business_logic": {
                "method": "activate_branch",
                "description": "Activate the branch",
                "spec": "Set STATUS to 'A' (Active) for the current branch record and return {\"updates\": {\"status\": \"A\"}} so the form reflects the change.",
                "language": "plpgsql"
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Must be inactive to activate",
                  "error_code": "ALREADY_ACTIVE",
                  "message": "Branch {form.branch_code} is already Active.",
                  "expression": "{form.status} == \"I\""
                }
              ]
            },
            {
              "name": "Deactivate",
              "handler": "item_change",
              "scope": "row",
              "business_logic": {
                "method": "deactivate_branch",
                "description": "Deactivate the branch",
                "spec": "Set STATUS to 'I' (Inactive) for the current branch record and return {\"updates\": {\"status\": \"I\"}} so the form reflects the change.",
                "language": "plpgsql"
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Must be active to deactivate",
                  "error_code": "ALREADY_INACTIVE",
                  "message": "Branch {form.branch_code} is already Inactive.",
                  "expression": "{form.status} == \"A\""
                }
              ]
            }
          ],
