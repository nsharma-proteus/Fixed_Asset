          "actions": [
            {
              "name": "Delete",
              "handler": "system",
              "system_op": "delete",
              "scope": "row",
              "validations": [
                {
                  "type": "business_logic",
                  "name": "Rate not in use",
                  "error_code": "DEP_RATE_IT_IN_USE",
                  "message": "This Income Tax block rate cannot be deleted because it is referenced by the Asset Category Master or has been used in a posted Income Tax depreciation run.",
                  "business_logic": {
                    "method": "check_dep_rate_it_unused",
                    "description": "Block delete if the block rate is referenced elsewhere",
                    "spec": "Given BLOCK_CODE in the payload, check whether it is referenced by FAM_ASSET_CATEGORY_MASTER.INCOME_TAX_BLOCK_CODE or by any posted Income Tax annual depreciation generation record for that block (only tables that exist in the project at deploy time need to be checked). If any matching reference exists, return an error indicating the block rate is in use and cannot be deleted. Otherwise return no error so the delete proceeds.",
                    "language": "plpgsql"
                  }
                }
              ]
            }
          ],
          "validations": [
            {
              "type": "expression",
              "name": "Opening WDV as-on date required with block Opening WDV",
              "error_code": "IT_BLOCK_OPENING_WDV_DATE_REQUIRED",
              "message": "Block {form.block_code}: Opening WDV As On Date is required when Opening WDV (Block) is entered.",
              "expression": "is_empty({form.opening_wdv}) or {form.opening_wdv} <= 0 or not_empty({form.opening_wdv_as_on_date})"
            }
          ]
