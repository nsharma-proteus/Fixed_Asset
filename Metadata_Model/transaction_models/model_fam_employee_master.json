          },
          "actions": [
            {
              "name": "delete",
              "handler": "system",
              "system_op": "delete",
              "scope": "row",
              "validations": [
                {
                  "type": "business_logic",
                  "name": "Employee unused check",
                  "message": "This employee cannot be deleted because one or more assets are currently assigned to them.",
                  "business_logic": {
                    "method": "check_employee_unused",
                    "description": "Block delete when the employee has assets assigned to them",
                    "spec": "Given the current row's EMPLOYEE_CODE, check whether any row exists in the Asset Register (FAM_ASSET_REGISTER) with ASSIGNED_EMPLOYEE_CODE matching this employee. If at least one such asset exists, return an error so the delete is blocked; otherwise return NULL/no error to allow the delete to proceed.",
                    "language": "plpgsql"
                  }
                }
              ]
            },
            {
              "name": "Activate",
              "handler": "message",
              "scope": "row",
              "business_logic": {
                "method": "activate_employee",
                "description": "Activate the employee",
                "spec": "UPDATE FAM_EMPLOYEE_MASTER SET STATUS = 'A', CHG_DATE = current timestamp, CHG_USER = current user, CHG_TERM = current terminal WHERE EMPLOYEE_CODE = the payload's EMPLOYEE_CODE. Return a confirmation message that the employee was activated.",
                "language": "plpgsql"
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Must not already be active",
                  "message": "Employee {form.employee_code} is already Active.",
                  "expression": "{form.status} != \"A\""
                }
              ]
            },
            {
              "name": "Deactivate",
              "handler": "message",
              "scope": "row",
              "business_logic": {
                "method": "deactivate_employee",
                "description": "Deactivate the employee and flag their assigned assets for reassignment",
                "spec": "UPDATE FAM_EMPLOYEE_MASTER SET STATUS = 'I', CHG_DATE = current timestamp, CHG_USER = current user, CHG_TERM = current terminal WHERE EMPLOYEE_CODE = the payload's EMPLOYEE_CODE. Then, for every row in the Asset Register (FAM_ASSET_REGISTER) whose ASSIGNED_EMPLOYEE_CODE matches this employee, mark/flag it as needing reassignment (e.g. set a REMARKS note or a pending-reassignment indicator) so it surfaces for handling via the Asset Transfer process. Return a confirmation message that the employee was deactivated and how many assets were flagged for reassignment.",
                "language": "plpgsql"
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Must not already be inactive",
                  "message": "Employee {form.employee_code} is already Inactive.",
                  "expression": "{form.status} != \"I\""
                }
              ]
            }
          ],
          "validations": []
