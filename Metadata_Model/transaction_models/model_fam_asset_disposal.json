                "col_type": "DATE",
                "heading": "Disposal Date",
                "descr": "Date the disposal is recorded",
                "default_value": "today()",
                "mandatory": true,
                "x": "20",
                "y": "20",
                "col_id": "2",
                "table_name": "FAM_ASSET_DISPOSAL",
                "table_display_name": "Asset Disposal records",
                "db_size": "",
                "width": 50,
                "key": false,
                "hidden": "",
