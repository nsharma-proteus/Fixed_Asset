                "db_name": "STATUS",
                "group_name": "Basic",
                "col_type": "VARCHAR",
                "heading": "Status",
                "descr": "Disposal workflow status",
                "default_value": "DRAFT",
                "protect": "1",
                "mandatory": true,
                "edit_mask": {
                  "mask": "ddlb",
                  "values": [
                    {
                      "data": "DRAFT",
                      "display": "Draft"
                    },
                    {
                      "data": "PENDING_APPROVAL",
                      "display": "Pending Approval"
                    },
                    {
                      "data": "APPROVED",
                      "display": "Approved"
                    },
                    {
                      "data": "CANCELLED",
                      "display": "Cancelled"
                    }
                  ]
                },
                "display": {
                  "type": "status_tag",
                  "map": [
                    {
                      "when": "DRAFT",
                      "color": "grey",
                      "icon": "\u25f7"
                    },
                    {
                      "when": "PENDING_APPROVAL",
                      "color": "amber",
                      "icon": "\u25f7"
                    },
                    {
                      "when": "APPROVED",
                      "color": "green",
                      "icon": "\u2713"
                    },
                    {
                      "when": "CANCELLED",
                      "color": "red",
                      "icon": "\u2715"
                    }
                  ],
                  "defaultColor": "grey"
                },
                "x": "60",
                "y": "60",
                "col_id": "6",
                "table_name": "FAM_ASSET_DISPOSAL",
                "table_display_name": "Asset Disposal records",
                "db_size": "20",
                "width": 200,
                "key": false,
                "hidden": "",
                "format": "",
                "default_function": "",
                "expression": "",
                "validations": "",
                "lookup": ""
              }
            },
            {
              "column": {
                "name": "disposal_type",
                "db_name": "DISPOSAL_TYPE",
                "group_name": "Disposal Details",
                "col_type": "VARCHAR",
                "heading": "Disposal Type",
                "descr": "Whether the asset is sold or scrapped",
                "mandatory": true,
                "edit_mask": {
                  "mask": "ddlb",
                  "values": [
                    {
                      "data": "SALE",
                      "display": "Sale"
                    },
                    {
                      "data": "SCRAP",
                      "display": "Scrap"
                    }
                  ]
                },
                "item_change": {
                  "mode": "rule",
                  "fill": [
                    {
                      "form_col": "sale_value",
                      "expr": "iif({form.disposal_type} == \"SCRAP\", 0, {form.sale_value})"
                    },
                    {
                      "form_col": "profit_loss_on_disposal",
                      "expr": "iif({form.disposal_type} == \"SCRAP\", 0 - {form.net_book_value_as_on_disposal}, {form.sale_value} - {form.net_book_value_as_on_disposal})"
                    }
                  ],
                  "protect": [
                    {
                      "form_col": "sale_value",
                      "when": "{form.disposal_type} == \"SCRAP\""
                    }
                  ]
                },
                "x": "70",
                "y": "70",
                "col_id": "7",
                "table_name": "FAM_ASSET_DISPOSAL",
                "table_display_name": "Asset Disposal records",
                "db_size": "10",
                "width": 100,
