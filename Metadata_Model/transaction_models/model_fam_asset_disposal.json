{
  "transaction": {
    "obj_name": "fam_asset_disposal",
    "sql_models": [
      {
        "sql_model": {
          "form_title": "Asset Disposal",
          "form_descr": "Record the disposal of an asset by sale or scrap",
          "form_no": "1",
          "main_table": "FAM_ASSET_DISPOSAL",
          "columns": [
            {
              "column": {
                "name": "disposal_no",
                "db_name": "DISPOSAL_NO",
