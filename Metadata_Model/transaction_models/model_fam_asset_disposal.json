            {
              "column": {
                "name": "asset_code",
                "db_name": "ASSET_CODE",
                "group_name": "Basic",
                "col_type": "VARCHAR",
                "heading": "Asset Code",
                "descr": "Asset being disposed",
                "mandatory": true,
                "lookup": "FAM_ASSET_REGISTER(ASSET_NAME, ASSET_CODE)",
                "must_exist_in": "FAM_ASSET_REGISTER",
                "validations": [
                  {
                    "type": "business_logic",
                    "name": "Asset must not already be Disposed",
                    "message": "Asset {form.asset_code} has already been disposed and cannot be disposed again.",
                    "business_logic": {
                      "method": "check_asset_not_disposed",
                      "description": "Validate the asset is not already Disposed before allowing a new disposal",
                      "spec": "Look up the asset's current STATUS on the Asset Register for ASSET_CODE; return an error (e.g. {\"error\":\"...\"}) if it is already Disposed. NOTE: FAM_ASSET_REGISTER is currently designed with only ASSET_CODE, ASSET_NAME and CAPITALIZATION_DATE columns; a STATUS column must be added to it (by the Asset Register object) before this check can be implemented.",
                      "language": "plpgsql"
                    }
                  }
                ],
                "item_change": {
                  "mode": "business_logic",
                  "business_logic": {
                    "method": "fill_asset_disposal_details",
                    "description": "Fill asset name, capitalization date and computed NBV from the asset's depreciation records",
                    "spec": "On change of ASSET_CODE, select ASSET_NAME and CAPITALIZATION_DATE from FAM_ASSET_REGISTER for the given ASSET_CODE. Also compute NET_BOOK_VALUE_AS_ON_DISPOSAL as the asset's total capitalized cost less accumulated Companies Act depreciation posted up to the disposal date (from the Companies Act depreciation generation/posting records). Return {\"updates\": {...}} setting asset_name, capitalization_date and net_book_value_as_on_disposal, and also recompute profit_loss_on_disposal = sale_value - net_book_value_as_on_disposal. NOTE: no accumulated-depreciation/WDV ledger table exists yet in this project's design; until the Depreciation (Companies Act) generation object is built and exposes a queryable WDV/accumulated-depreciation source, net_book_value_as_on_disposal should default to the asset's TOTAL_CAPITALIZED_COST (once that column is added to FAM_ASSET_REGISTER) or 0, and this function must be revisited once that source exists.",
                    "language": "plpgsql"
                  }
                },
                "x": "30",
                "y": "30",
                "col_id": "3",
                "table_name": "FAM_ASSET_DISPOSAL",
                "table_display_name": "Asset Disposal records",
                "db_size": "20",
                "width": 200,
                "key": false,
                "hidden": "",
                "format": "",
                "default_function": "",
                "default_value": "",
                "expression": "",
                "edit_mask": "",
                "protect": ""
              }
