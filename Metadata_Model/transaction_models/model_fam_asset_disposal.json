          "validations": [
            {
              "type": "expression",
              "name": "Disposal date not before capitalization date",
              "error_code": "DISPOSAL_DATE_MIN",
              "message": "Disposal Date cannot be earlier than the asset's Capitalization Date ({form.capitalization_date}).",
              "expression": "not_empty({form.capitalization_date}) == false or {form.disposal_date} >= {form.capitalization_date}"
            }
          ]
        }
