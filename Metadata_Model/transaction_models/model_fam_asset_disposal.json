    ],
    "actions": [
      {
        "name": "edit",
        "handler": "system",
        "system_op": "edit",
        "scope": "row",
        "validations": [
          {
            "type": "expression",
            "name": "Draft only",
            "message": "Only DRAFT disposals can be edited (current status {form.status}).",
            "expression": "{form.status} == \"DRAFT\""
          }
        ]
      },
      {
        "name": "Submit for Approval",
        "handler": "message",
        "scope": "row",
        "business_logic": {
          "method": "submit_asset_disposal_for_approval",
          "description": "Move a Draft disposal to Pending Approval",
          "spec": "Set STATUS to PENDING_APPROVAL on this disposal record and return a confirmation message.",
          "language": "plpgsql"
        },
        "validations": [
          {
            "type": "expression",
            "name": "Must be Draft",
            "message": "Only DRAFT disposals can be submitted for approval (current status {form.status}).",
            "expression": "{form.status} == \"DRAFT\""
          }
        ]
      },
      {
        "name": "Approve",
        "handler": "message",
        "scope": "row",
        "business_logic": {
          "method": "approve_asset_disposal",
          "description": "Approve the disposal, mark the asset Disposed and exclude it from future depreciation",
          "spec": "Set STATUS to APPROVED on this disposal record. Then UPDATE the Asset Register row for ASSET_CODE, setting its STATUS to DISPOSED so the asset is excluded from future Companies Act and Income Tax depreciation generation runs and removed from its Income Tax block of assets from the next generation run. Return a confirmation message. Depends on FAM_ASSET_REGISTER carrying a STATUS column (currently only ASSET_CODE, ASSET_NAME and CAPITALIZATION_DATE exist there).",
          "language": "plpgsql"
        },
        "validations": [
          {
            "type": "expression",
            "name": "Must be Pending Approval",
            "message": "Only PENDING APPROVAL disposals can be approved (current status {form.status}).",
            "expression": "{form.status} == \"PENDING_APPROVAL\""
          }
        ],
        "confirmation": {
          "mode": "reconfirm",
          "message": "Approve disposal {form.disposal_no} for asset {form.asset_code}? This will mark the asset as Disposed."
        }
      },
      {
        "name": "Cancel",
        "handler": "message",
        "scope": "row",
        "business_logic": {
          "method": "cancel_asset_disposal",
          "description": "Cancel a Draft or Pending Approval disposal",
          "spec": "Set STATUS to CANCELLED on this disposal record and return a confirmation message. Approved disposals cannot be cancelled since the Asset Register has already been marked Disposed.",
          "language": "plpgsql"
        },
        "validations": [
          {
            "type": "expression",
            "name": "Cannot cancel Approved/Cancelled",
            "message": "Only DRAFT or PENDING APPROVAL disposals can be cancelled (current status {form.status}).",
            "expression": "{form.status} == \"DRAFT\" or {form.status} == \"PENDING_APPROVAL\""
          }
        ],
        "confirmation": {
          "mode": "reconfirm",
          "message": "Cancel disposal {form.disposal_no}?"
        }
      }
    ],
    "cross_updates": [],
    "pre_commit": [],
    "post_commit": [],
