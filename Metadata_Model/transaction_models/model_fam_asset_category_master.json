          },
          "actions": [
            {
              "name": "Delete",
              "handler": "system",
              "system_op": "delete",
              "scope": "row",
              "validations": [
                {
                  "type": "business_logic",
                  "name": "Block delete when category is in use",
                  "error_code": "CAT_IN_USE",
                  "message": "This category cannot be deleted because it is referenced by other records.",
                  "business_logic": {
                    "method": "check_category_unused",
                    "description": "Prevent deleting a category still referenced elsewhere",
                    "spec": "Given the CATEGORY_CODE of the row targeted for delete, block the delete (return an error) if the code is referenced as PARENT_CATEGORY_CODE by any other row in FAM_ASSET_CATEGORY_MASTER, or if it is referenced by CATEGORY_CODE on any capitalized/active row of the Asset Register (FAM_ASSET_REGISTER) once that table carries a CATEGORY_CODE column. Return no error (allow delete) when no references are found."
                  }
                }
              ]
            },
            {
              "name": "Activate",
              "handler": "item_change",
              "scope": "row",
              "business_logic": {
                "method": "activate_category",
                "description": "Activate this asset category",
                "spec": "Given the current row's CATEGORY_CODE, set STATUS to 'A' (Active) for this category and return {\"updates\": {\"status\": \"A\"}} so the change reflects immediately on the form."
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Must currently be Inactive",
                  "error_code": "CAT_ALREADY_ACTIVE",
                  "message": "This category is already Active.",
                  "expression": "{form.status} == \"I\""
                }
              ]
            },
            {
              "name": "Deactivate",
              "handler": "item_change",
              "scope": "row",
              "business_logic": {
                "method": "deactivate_category",
                "description": "Deactivate this asset category",
                "spec": "Given the current row's CATEGORY_CODE, set STATUS to 'I' (Inactive) for this category and return {\"updates\": {\"status\": \"I\"}}. Deactivating a category blocks its selection on new Asset Register entries but must not alter any existing asset already carrying this category code."
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Must currently be Active",
                  "error_code": "CAT_ALREADY_INACTIVE",
                  "message": "This category is already Inactive.",
                  "expression": "{form.status} == \"A\""
                }
              ]
            }
          ],
          "validations": []
        }
