              "business_logic": {
                "method": "check_warranty_period_overlap",
                "description": "Refuse a new warranty whose period overlaps an existing warranty of the same asset",
                "spec": "On a NEW warranty (_action='add') only: if another FAM_WARRANTY_DETAILS row of the same ASSET_CODE has a period overlapping WARRANTY_START_DATE..WARRANTY_END_DATE (same dates, within an existing period, or any shared day: existing start <= new end AND existing end >= new start), return the error 'Warranty for the selected dates are already available' and block the save. Edits are not checked.",
                "language": "python"
              }
            }
