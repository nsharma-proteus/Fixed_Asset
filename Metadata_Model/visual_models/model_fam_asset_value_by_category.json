  "SOURCE_SQL": "SELECT\n  category_code AS CATEGORY_CODE,\n  COUNT(*) AS CATEGORY_VALUE\nFROM fam_dep_rate_ca_master\nWHERE effective_from_date <= CURRENT_DATE\nGROUP BY category_code\nORDER BY category_code"
