  "SOURCE_SQL": "SELECT\n  c.amc_contract_no AS AMC_CONTRACT_NO,\n  c.amc_vendor_code AS AMC_VENDOR_CODE,\n  c.start_date AS CONTRACT_START_DATE,\n  c.end_date AS CONTRACT_END_DATE,\n  c.status AS CONTRACT_STATUS,\n  ar.asset_code AS ASSET_CODE,\n  ar.asset_name AS ASSET_NAME,\n  br.branch_name AS BRANCH_NAME,\n  cat.category_name AS CATEGORY_NAME,\n  CASE WHEN c.end_date < CURRENT_DATE THEN 'EXPIRED' ELSE 'EXPIRING_SOON' END AS EXPIRY_INDICATOR,\n  (c.end_date - CURRENT_DATE) AS DAYS_TO_EXPIRY\nFROM fam_amc_contracts c\nJOIN fam_amc_contract_line cl ON cl.amc_contract_no = c.amc_contract_no\nJOIN fam_asset_register ar ON ar.asset_code = cl.asset_code\nLEFT JOIN fam_branch_master br ON br.branch_code = ar.branch_code\nLEFT JOIN fam_asset_category_master cat ON cat.category_code = ar.category_code\nWHERE c.end_date <= ?.expiry_on_or_before\n  AND ar.branch_code LIKE ?.branch_code\nORDER BY c.end_date ASC\nLIMIT 500"
}
