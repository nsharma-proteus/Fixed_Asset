  "SOURCE_SQL": "SELECT TO_CHAR(DATE_TRUNC('month', ar.capitalization_date), 'Mon-YYYY') AS PERIOD_MONTH, COUNT(DISTINCT ar.asset_code) AS ASSETS_CAPITALIZED FROM fam_asset_register ar LEFT JOIN (SELECT t.asset_code, t.to_branch_code, ROW_NUMBER() OVER (PARTITION BY t.asset_code ORDER BY t.transfer_date DESC, t.transfer_no DESC) AS rn FROM fam_asset_transfer t WHERE t.status = 'APPROVED') lt ON lt.asset_code = ar.asset_code AND lt.rn = 1 LEFT JOIN (SELECT DISTINCT d.asset_code FROM fam_asset_disposal d WHERE d.status = 'APPROVED') da ON da.asset_code = ar.asset_code WHERE ar.capitalization_date BETWEEN ?.fy_start_date AND ?.fy_end_date AND da.asset_code IS NULL AND (lt.to_branch_code LIKE ?.branch_code OR lt.to_branch_code IS NULL) GROUP BY DATE_TRUNC('month', ar.capitalization_date) ORDER BY DATE_TRUNC('month', ar.capitalization_date)"
}
