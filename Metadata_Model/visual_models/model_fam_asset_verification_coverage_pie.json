  "SOURCE_SQL": "SELECT\n  cat.category_name AS CATEGORY_NAME,\n  COUNT(DISTINCT v.asset_code) AS VERIFIED_ASSETS\nFROM fam_asset_register r\nJOIN fam_asset_category_master cat ON cat.category_code = r.category_code\nLEFT JOIN fam_physical_verification_line v\n  ON v.asset_code = r.asset_code\n AND v.verified_date IS NOT NULL\n AND v.verified_date >= ?.period_from_date\n AND v.verified_date <= CURRENT_DATE\nWHERE r.status = 'ACTIVE'\n  AND r.category_code LIKE ?.category_code\nGROUP BY cat.category_code, cat.category_name\nORDER BY VERIFIED_ASSETS DESC"
}
