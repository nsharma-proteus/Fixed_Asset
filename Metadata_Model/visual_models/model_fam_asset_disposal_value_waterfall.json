  "SOURCE_SQL": "SELECT d.disposal_type AS DISPOSAL_CATEGORY, SUM(d.profit_loss_on_disposal) AS DISPOSAL_VALUE FROM fam_asset_disposal d JOIN fam_asset_register ar ON ar.asset_code = d.asset_code WHERE d.status <> 'CANCELLED' AND d.disposal_date >= make_date(split_part(?.financial_year, '-', 1)::int, 4, 1) AND d.disposal_date < make_date(split_part(?.financial_year, '-', 1)::int + 1, 4, 1) AND ar.branch_code LIKE ?.branch_code GROUP BY d.disposal_type ORDER BY d.disposal_type"
}
