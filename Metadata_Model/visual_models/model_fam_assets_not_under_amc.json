  "SOURCE_SQL": "SELECT\n  ar.asset_code AS ASSET_CODE,\n  ar.asset_name AS ASSET_NAME,\n  cat.category_name AS CATEGORY_NAME,\n  br.branch_name AS BRANCH_NAME,\n  ar.status AS STATUS,\n  ar.make AS MAKE,\n  ar.model AS MODEL,\n  ar.purchase_date AS PURCHASE_DATE,\n  ar.purchase_cost AS PURCHASE_COST\nFROM fam_asset_register ar\nLEFT JOIN fam_asset_category_master cat ON cat.category_code = ar.category_code\nLEFT JOIN fam_branch_master br ON br.branch_code = ar.branch_code\nWHERE COALESCE(ar.amc_applicable, 'N') <> 'Y'\n  AND ar.category_code LIKE ?.category_code\n  AND ar.branch_code LIKE ?.branch_code\nORDER BY ar.asset_code\nLIMIT 500"
}
