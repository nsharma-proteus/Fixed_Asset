  "SOURCE_SQL": "SELECT\n  TO_CHAR(DATE_TRUNC('month', i.installation_date), 'Mon-YYYY') AS PERIOD_LABEL,\n  DATE_TRUNC('month', i.installation_date)::date AS PERIOD_DATE,\n  COUNT(DISTINCT i.asset_code) AS GROSS_ASSET_VALUE,\n  'Total Gross Asset Value (Assets Installed)' AS LBL_HEADLINE\nFROM fam_asset_installation i\nLEFT JOIN LATERAL (\n  SELECT t.to_branch_code\n  FROM fam_asset_transfer t\n  WHERE t.asset_code = i.asset_code AND t.status = 'APPROVED'\n  ORDER BY t.transfer_date DESC\n  LIMIT 1\n) cur ON TRUE\nWHERE i.status = 'CONFIRMED'\n  AND i.installation_date BETWEEN ?.@1stDayOfFinYear AND ?.@Today\n  AND COALESCE(cur.to_branch_code, '') LIKE ?.branch_code\nGROUP BY 1, 2\nORDER BY 2 ASC"
}
