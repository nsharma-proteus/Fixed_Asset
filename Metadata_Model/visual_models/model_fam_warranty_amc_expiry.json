                { "when": "PENDING_APPROVAL", "color": "orange", "label": "Pending Approval" },
                { "when": "RENEWED", "color": "blue", "label": "Renewed" },
                { "when": "CANCELLED", "color": "gray", "label": "Cancelled" } ] },
              "groupName": "Columns", "StandardName": "Columns", "checked": true }
          ]
        }
      ]
    },
    "layoutdata": {}
  },
  "SOURCE_SQL": "WITH warranty_rows AS (\n  SELECT\n    w.asset_code AS asset_code,\n    'WARRANTY' AS type,\n    w.warranty_provider_vendor_code AS provider_vendor_code,\n    w.warranty_start_date AS start_date,\n    w.warranty_end_date AS end_date,\n    (w.warranty_end_date - CURRENT_DATE) AS days_to_expiry,\n    CASE WHEN w.warranty_end_date >= CURRENT_DATE THEN 'ACTIVE' ELSE 'EXPIRED' END AS status\n  FROM fam_warranty_details w\n),\namc_rows AS (\n  SELECT\n    cl.asset_code AS asset_code,\n    'AMC' AS type,\n    c.amc_vendor_code AS provider_vendor_code,\n    c.start_date AS start_date,\n    c.end_date AS end_date,\n    (c.end_date - CURRENT_DATE) AS days_to_expiry,\n    c.status AS status\n  FROM fam_amc_contract_line cl\n  JOIN fam_amc_contracts c ON c.amc_contract_no = cl.amc_contract_no\n),\ncombined AS (\n  SELECT * FROM warranty_rows\n  UNION ALL\n  SELECT * FROM amc_rows\n)\nSELECT\n  cm.asset_code AS ASSET_CODE,\n  COALESCE(\n    (SELECT t.asset_name FROM fam_asset_transfer t WHERE t.asset_code = cm.asset_code ORDER BY t.transfer_date DESC LIMIT 1),\n    (SELECT d.asset_name FROM fam_asset_disposal d WHERE d.asset_code = cm.asset_code ORDER BY d.disposal_date DESC LIMIT 1)\n  ) AS ASSET_NAME,\n  cm.type AS TYPE,\n  cm.provider_vendor_code AS PROVIDER_VENDOR_CODE,\n  cm.start_date AS START_DATE,\n  cm.end_date AS END_DATE,\n  cm.days_to_expiry AS DAYS_TO_EXPIRY,\n  cm.status AS STATUS\nFROM combined cm\nLEFT JOIN LATERAL (\n  SELECT t.to_branch_code, t.to_location_code\n  FROM fam_asset_transfer t\n  WHERE t.asset_code = cm.asset_code AND t.status = 'APPROVED'\n  ORDER BY t.transfer_date DESC\n  LIMIT 1\n) cur ON TRUE\nWHERE cm.type IN ?.type_filter\n  AND cm.status IN ?.status_filter\n  AND cm.end_date BETWEEN ?.expiry_from AND ?.expiry_to\n  AND COALESCE(cur.to_branch_code, '') LIKE ?.branch_code\n  AND COALESCE(cur.to_location_code, '') LIKE ?.location_code\nORDER BY cm.end_date ASC\nLIMIT 500"
}
