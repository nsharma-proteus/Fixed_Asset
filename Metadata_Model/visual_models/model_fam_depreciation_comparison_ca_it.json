  "SOURCE_SQL": "WITH ca_ranked AS (SELECT category_code, useful_life_years, method, residual_value_pct, effective_from_date, ROW_NUMBER() OVER (PARTITION BY category_code ORDER BY effective_from_date DESC) AS rn FROM fam_dep_rate_ca_master WHERE effective_from_date <= ?.as_on_date), ca_rates AS (SELECT category_code AS group_code, category_code AS group_label, CASE WHEN method = 'SLM' THEN ROUND((100 - residual_value_pct) / NULLIF(useful_life_years, 0), 2) ELSE ROUND((1 - POWER(residual_value_pct / 100.0, 1.0 / NULLIF(useful_life_years, 0))) * 100, 2) END AS rate_pct FROM ca_ranked WHERE rn = 1), it_ranked AS (SELECT block_code, block_description, rate_pct, effective_from_date, ROW_NUMBER() OVER (PARTITION BY block_code ORDER BY effective_from_date DESC) AS rn FROM fam_dep_rate_it_master WHERE effective_from_date <= ?.as_on_date), it_rates AS (SELECT block_code AS group_code, block_description AS group_label, rate_pct FROM it_ranked WHERE rn = 1), combined AS (SELECT group_label AS RATE_GROUP_LABEL, 'Companies Act' AS DEP_METHOD, rate_pct AS ANNUAL_RATE_PCT FROM ca_rates UNION ALL SELECT group_label, 'Income Tax', rate_pct FROM it_rates) SELECT RATE_GROUP_LABEL, DEP_METHOD, SUM(ANNUAL_RATE_PCT) AS ANNUAL_RATE_PCT FROM combined GROUP BY RATE_GROUP_LABEL, DEP_METHOD ORDER BY DEP_METHOD, RATE_GROUP_LABEL"
}
