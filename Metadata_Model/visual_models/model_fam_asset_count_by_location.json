  "SOURCE_SQL": "WITH latest_transfer AS (SELECT t.asset_code, t.to_branch_code, t.to_location_code, ROW_NUMBER() OVER (PARTITION BY t.asset_code ORDER BY t.transfer_date DESC, t.transfer_no DESC) AS rn FROM fam_asset_transfer t WHERE t.status = 'APPROVED'), disposed_assets AS (SELECT DISTINCT d.asset_code FROM fam_asset_disposal d WHERE d.status = 'APPROVED') SELECT lm.location_name AS LOCATION_NAME, COUNT(DISTINCT ar.asset_code) AS ASSET_COUNT FROM fam_asset_register ar JOIN latest_transfer lt ON lt.asset_code = ar.asset_code AND lt.rn = 1 JOIN fam_location_master lm ON lm.branch_code = lt.to_branch_code AND lm.location_code = lt.to_location_code LEFT JOIN disposed_assets da ON da.asset_code = ar.asset_code WHERE da.asset_code IS NULL AND ar.capitalization_date <= ?.fy_end_date AND lt.to_branch_code LIKE ?.branch_code GROUP BY lm.location_name ORDER BY ASSET_COUNT DESC"
}
