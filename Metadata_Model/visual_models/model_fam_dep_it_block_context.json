  "SOURCE_SQL": "WITH sel_asset AS (SELECT asset_code, total_capitalized_cost, income_tax_block_code FROM fam_asset_register WHERE asset_code = ?.asset_code), block_rows AS (SELECT b.* FROM fam_dep_income_tax_block b JOIN sel_asset a ON b.block_code = a.income_tax_block_code) SELECT br.assessment_year AS ASSESSMENT_YEAR, br.block_code AS BLOCK_CODE, br.block_description AS BLOCK_DESCRIPTION, br.rate_pct AS RATE_PCT, br.opening_wdv AS BLOCK_OPENING_WDV, br.additions_180_days_or_more AS BLOCK_ADDITIONS_180_OR_MORE, br.additions_less_than_180_days AS BLOCK_ADDITIONS_LESS_THAN_180, br.disposals_during_year AS BLOCK_DISPOSALS_DURING_YEAR, br.net_block AS BLOCK_NET_BLOCK, br.depreciation_amount AS BLOCK_DEPRECIATION_AMOUNT, br.closing_wdv AS BLOCK_CLOSING_WDV, br.status AS BLOCK_STATUS, sel.total_capitalized_cost AS THIS_ASSET_CAPITALIZED_COST, ROUND(br.depreciation_amount * (sel.total_capitalized_cost / NULLIF((SELECT SUM(ar2.total_capitalized_cost) FROM fam_asset_register ar2 WHERE ar2.income_tax_block_code = br.block_code AND ar2.capitalization_date <= make_date((br.assessment_year::integer + 1), 3, 31)), 0)), 2) AS IT_DEP_ALLOCATED_TO_ASSET_EST FROM block_rows br CROSS JOIN sel_asset sel ORDER BY br.assessment_year"
}
