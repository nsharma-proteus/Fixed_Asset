    "VISUAL_NAME": "Grid",
    "SCHEMA_NAME": "FAM_ASSET_MOVEMENT_HISTORY",
    "SCHEMA_DESCR": "Asset-wise physical movement/transfer trail from FAM_ASSET_TRANSFER, joined to FAM_ASSET_REGISTER + FAM_ASSET_CATEGORY_MASTER for the asset's category. Filterable by a specific asset (ASSET_CODE lookup) and/or a whole category (CATEGORY_CODE lookup); defaults to STATUS=APPROVED (only Approved transfers are actual completed physical moves — Draft/Pending Approval/Cancelled are proposals that never happened), user can broaden to see other statuses. Rows sorted asset-wise then chronologically (TRANSFER_DATE ascending) so it reads as a per-asset movement trail.",
    "SCHEMA_TYPE": "S",
    "OUTPUT_TYPE": "JSON",
    "DATABASE_TYPE": "1",
    "DATABASE_DETAIL": { "DATABASE_NAME": "PostgreSQL", "TYPE": 1 }
  },
