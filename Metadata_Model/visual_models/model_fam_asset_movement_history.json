  "SOURCE_SQL": "SELECT\n  t.asset_code AS ASSET_CODE,\n  t.asset_name AS ASSET_NAME,\n  c.category_name AS CATEGORY_NAME,\n  t.transfer_no AS TRANSFER_NO,\n  t.transfer_date AS TRANSFER_DATE,\n  t.status AS STATUS,\n  t.from_branch_name AS FROM_BRANCH_NAME,\n  t.from_location_name AS FROM_LOCATION_NAME,\n  t.from_department_name AS FROM_DEPARTMENT_NAME,\n  t.from_employee_name AS FROM_EMPLOYEE_NAME,\n  t.to_branch_name AS TO_BRANCH_NAME,\n  t.to_location_name AS TO_LOCATION_NAME,\n  t.to_department_name AS TO_DEPARTMENT_NAME,\n  t.to_employee_name AS TO_EMPLOYEE_NAME,\n  t.transfer_reason AS TRANSFER_REASON\nFROM fam_asset_transfer t\nLEFT JOIN fam_asset_register r ON r.asset_code = t.asset_code\nLEFT JOIN fam_asset_category_master c ON c.category_code = r.category_code\nWHERE t.asset_code LIKE ?.asset_code\n  AND COALESCE(r.category_code, '') LIKE ?.category_code\n  AND t.status IN ?.status_filter\nORDER BY t.asset_code ASC, t.transfer_date ASC\nLIMIT 1000"
}
