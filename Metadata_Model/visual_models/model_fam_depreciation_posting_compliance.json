  "SOURCE_SQL": "SELECT 0::numeric AS COMPLIANCE_PCT, 100::numeric AS TARGET_PCT, 0::numeric AS MIN_PCT, 100::numeric AS MAX_PCT FROM (SELECT COUNT(*) AS eligible_count FROM fam_asset_register ar WHERE ar.status = 'ACTIVE' AND ar.capitalization_date <= LEAST(CURRENT_DATE, make_date(split_part(?.financial_year, '-', 1)::int + 1, 3, 31)) AND ar.branch_code LIKE ?.branch_code) eligible"
}
