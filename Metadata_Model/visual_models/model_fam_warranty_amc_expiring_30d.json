  "SOURCE_SQL": "SELECT\n  (\n    (SELECT COUNT(*) FROM fam_warranty_details w\n     LEFT JOIN LATERAL (\n       SELECT t.to_branch_code\n       FROM fam_asset_transfer t\n       WHERE t.asset_code = w.asset_code AND t.status = 'APPROVED'\n       ORDER BY t.transfer_date DESC\n       LIMIT 1\n     ) cur ON TRUE\n     WHERE w.warranty_end_date BETWEEN CURRENT_DATE AND CURRENT_DATE + 30\n       AND COALESCE(cur.to_branch_code, '') LIKE ?.branch_code)\n    +\n    (SELECT COUNT(DISTINCT cl.asset_code) FROM fam_amc_contract_line cl\n     JOIN fam_amc_contracts c ON c.amc_contract_no = cl.amc_contract_no\n     LEFT JOIN LATERAL (\n       SELECT t.to_branch_code\n       FROM fam_asset_transfer t\n       WHERE t.asset_code = cl.asset_code AND t.status = 'APPROVED'\n       ORDER BY t.transfer_date DESC\n       LIMIT 1\n     ) cur ON TRUE\n     WHERE c.status = 'ACTIVE'\n       AND c.end_date BETWEEN CURRENT_DATE AND CURRENT_DATE + 30\n       AND COALESCE(cur.to_branch_code, '') LIKE ?.branch_code)\n  ) AS EXPIRING_COUNT,\n  'Warranty/AMC Expiring in 30 Days' AS LBL_HEADLINE"
}
