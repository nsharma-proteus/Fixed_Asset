  "SOURCE_SQL": "WITH latest_cycle AS (SELECT verification_cycle_no, branch_code, verification_date, ROW_NUMBER() OVER (ORDER BY verification_date DESC, verification_cycle_no DESC) AS rn FROM fam_physical_verification WHERE branch_code LIKE ?.branch_code) SELECT COALESCE(l.physical_status_found, 'PENDING') AS STATUS_FOUND, COUNT(*) AS ASSET_COUNT FROM latest_cycle lc JOIN fam_physical_verification_line l ON l.verification_cycle_no = lc.verification_cycle_no WHERE lc.rn = 1 GROUP BY COALESCE(l.physical_status_found, 'PENDING') ORDER BY ASSET_COUNT DESC"
}
