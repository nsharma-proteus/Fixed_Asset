      "mandatory": true,
      "allowed_values": [
        {
          "value": "DRAFT",
          "label": "Draft"
        },
        {
          "value": "PENDING_APPROVAL",
          "label": "Pending Approval"
        },
        {
          "value": "APPROVED",
          "label": "Approved"
        },
        {
          "value": "CANCELLED",
          "label": "Cancelled"
        }
      ]
    },
