      "data_type": "VARCHAR",
      "size": "20",
      "key": true,
      "description": "Auto-generated transfer number",
      "sequence": 1,
      "mandatory": true
    },
    {
      "column_name": "TRANSFER_DATE",
      "data_type": "DATE",
      "size": "",
      "key": false,
      "description": "Date the transfer is recorded",
      "sequence": 2,
      "mandatory": true
    },
    {
      "column_name": "ASSET_CODE",
      "data_type": "VARCHAR",
      "size": "20",
      "key": false,
