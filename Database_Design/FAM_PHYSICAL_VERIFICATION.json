        {
          "value": "PENDING_APPROVAL",
          "label": "Pending Approval"
        },
        {
          "value": "CLOSED",
          "label": "Closed"
        },
        {
          "value": "CANCELLED",
          "label": "Cancelled"
        }
      ]
