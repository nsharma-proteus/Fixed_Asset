      "description": "Auto-generated AMC contract number",
      "sequence": 1,
      "mandatory": true
    },
    {
      "column_name": "AMC_VENDOR_CODE",
      "data_type": "VARCHAR",
      "size": "20",
      "key": false,
      "description": "Vendor providing the AMC coverage. Assumption: modeled as free text since no Vendor/Supplier Master table exists yet in this project -- wire a lookup once that master is designed.",
      "sequence": 2,
      "mandatory": true
    },
    {
      "column_name": "START_DATE",
      "data_type": "DATE",
      "size": "",
