      "key": false,
      "description": "Total cost of the AMC contract",
      "sequence": 5,
      "mandatory": true
    },
    {
      "column_name": "STATUS",
      "data_type": "VARCHAR",
      "size": "20",
      "key": false,
      "description": "Contract lifecycle status. Assumption: DRAFT and PENDING_APPROVAL were added ahead of Active, to support the FRS-required Submit-for-approval/Approve actions -- the FRS's own STATUS list (Active/Expired/Renewed/Cancelled) has no pre-approval state.",
      "sequence": 6,
      "mandatory": true,
      "allowed_values": [
        {
          "value": "DRAFT",
          "label": "Draft"
        },
        {
          "value": "PENDING_APPROVAL",
          "label": "Pending Approval"
        },
        {
          "value": "ACTIVE",
          "label": "Active"
        },
        {
          "value": "EXPIRED",
          "label": "Expired"
        },
        {
          "value": "RENEWED",
          "label": "Renewed"
        },
        {
          "value": "CANCELLED",
          "label": "Cancelled"
        }
      ]
    },
    {
      "column_name": "PREVIOUS_CONTRACT_NO",
      "data_type": "VARCHAR",
      "size": "20",
      "key": false,
      "description": "Prior AMC contract this record renews (set automatically by the Renew action)",
      "sequence": 7,
      "lookup": {
        "table": "FAM_AMC_CONTRACTS",
        "display_column": "AMC_VENDOR_CODE",
        "value_column": "AMC_CONTRACT_NO"
      }
    },
    {
