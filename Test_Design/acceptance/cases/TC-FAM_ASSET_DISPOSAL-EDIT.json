{
  "id": "TC-FAM_ASSET_DISPOSAL-EDIT",
  "title": "Asset Sale / Scrap: a record can be edited",
  "object": "fam_asset_disposal",
  "surface": "app",
  "type": "positive",
  "priority": "high",
  "persona": "owner",
  "origin": "seed",
  "requirement": [
    "FRS-5.3"
  ],
  "preconditions": [
    {
      "do": "seed_record",
      "obj": "fam_asset_disposal",
      "save_as": "rec"
    }
  ],
  "steps": [
    {
      "do": "open_screen",
      "obj": "fam_asset_disposal"
    },
    {
      "do": "select_row",
      "record": "rec"
    },
    {
      "do": "click_action",
      "name": "edit"
    },
    {
      "do": "fill",
      "field": "disposal_reason",
      "value": "@synthetic"
    },
    {
      "do": "click_action",
      "name": "save_close"
    },
    {
      "expect": "message",
      "kind": "error",
      "absent": true
    },
    {
      "expect": "record",
      "obj": "fam_asset_disposal",
      "where": {
        "disposal_reason": "@filled"
      }
    },
    {
      "expect": "no_console_errors"
    },
    {
      "expect": "no_failed_requests"
    }
  ],
  "seed_hash": "943306aa050ff0c6"
}
