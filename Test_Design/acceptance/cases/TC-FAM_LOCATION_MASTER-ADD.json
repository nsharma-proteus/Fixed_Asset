{
  "id": "TC-FAM_LOCATION_MASTER-ADD",
  "title": "Location Master: a valid record can be added",
  "object": "fam_location_master",
  "surface": "app",
  "type": "positive",
  "priority": "high",
  "persona": "owner",
  "origin": "seed",
  "requirement": [
    "FRS-2.2"
  ],
  "steps": [
    {
      "do": "open_screen",
      "obj": "fam_location_master"
    },
    {
      "do": "click_action",
      "name": "add"
    },
    {
      "do": "fill",
      "field": "branch_code",
      "value": "@lookup"
    },
    {
      "do": "fill",
      "field": "location_code",
      "value": "@synthetic"
    },
    {
      "do": "fill",
      "field": "location_name",
      "value": "@synthetic"
    },
    {
      "do": "fill",
      "field": "status",
      "value": "@synthetic"
    },
    {
      "do": "screenshot",
      "label": "filled"
    },
    {
      "do": "click_action",
      "name": "save_close"
    },
    {
      "expect": "message",
      "kind": "error",
      "absent": true
    },
    {
      "expect": "record",
      "obj": "fam_location_master",
      "where": {
        "location_name": "@filled"
      }
    },
    {
      "expect": "no_console_errors"
    },
    {
      "expect": "no_failed_requests"
    }
  ],
  "seed_hash": "7671dd78239c1efc"
}
