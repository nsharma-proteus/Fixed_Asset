{
  "id": "TC-FAM_EMPLOYEE_MASTER-EDIT",
  "title": "Employee Master: a record can be edited",
  "object": "fam_employee_master",
  "surface": "app",
  "type": "positive",
  "priority": "high",
  "persona": "owner",
  "origin": "seed",
  "requirement": [
    "FRS-2.4"
  ],
  "preconditions": [
    {
      "do": "seed_record",
      "obj": "fam_employee_master",
      "save_as": "rec"
    }
  ],
  "steps": [
    {
      "do": "open_screen",
      "obj": "fam_employee_master"
    },
    {
      "do": "select_row",
      "record": "rec"
    },
    {
      "do": "click_action",
      "name": "edit"
    },
    {
      "do": "fill",
      "field": "employee_name",
      "value": "@synthetic"
    },
    {
      "do": "click_action",
      "name": "save_close"
    },
    {
      "expect": "message",
      "kind": "error",
      "absent": true
    },
    {
      "expect": "record",
      "obj": "fam_employee_master",
      "where": {
        "employee_name": "@filled"
      }
    },
    {
      "expect": "no_console_errors"
    },
    {
      "expect": "no_failed_requests"
    }
  ],
  "seed_hash": "8cb4c6b2174425ed"
}
